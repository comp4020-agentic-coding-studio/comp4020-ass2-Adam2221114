---
/** Small named line-icon set for the home page only. Deliberately abstract
 *  and geometric (circles, hexagons, arcs) rather than literal object
 *  drawings, so they read as accents beside the two large illustrations
 *  rather than competing with them. Colour comes from `currentColor`, so
 *  each usage site controls it (and dark mode) via CSS, same as the
 *  surrounding text. */
export type HomeIconName =
  | "magnifier"
  | "blocks"
  | "gauge"
  | "loop"
  | "pen"
  | "hexagon"
  | "people"
  | "spark"
  | "book"
  | "chat"
  | "flask"
  | "clipboard"
  | "crack"
  | "speaker";

export interface Props {
  name: HomeIconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["home-icon", className]}
  aria-hidden="true"
  focusable="false"
>
  {
    name === "magnifier" && (
      <>
        <circle cx="10.5" cy="10.5" r="6.2" />
        <line x1="15.3" y1="15.3" x2="20.5" y2="20.5" />
      </>
    )
  }
  {
    name === "blocks" && (
      <>
        <rect x="3.2" y="3.2" width="7.2" height="7.2" rx="1.2" />
        <rect x="13.6" y="3.2" width="7.2" height="7.2" rx="1.2" />
        <rect x="3.2" y="13.6" width="7.2" height="7.2" rx="1.2" />
        <rect x="13.6" y="13.6" width="7.2" height="7.2" rx="1.2" />
      </>
    )
  }
  {
    name === "gauge" && (
      <>
        <path d="M4 17a8 8 0 0 1 16 0" />
        <line x1="12" y1="17" x2="15.5" y2="10" />
        <circle cx="12" cy="17" r="1.3" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "loop" && (
      <>
        <path d="M21 12a9 9 0 1 1-3-6.7" />
        <polyline points="21 3 21 9 15 9" />
      </>
    )
  }
  {
    name === "pen" && (
      <>
        <line x1="5" y1="19" x2="19" y2="5" />
        <circle cx="19" cy="5" r="1.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === "hexagon" && (
      <>
        <polygon points="12,4 19,8 19,16 12,20 5,16 5,8" />
        <circle cx="12" cy="12" r="2.2" />
      </>
    )
  }
  {
    name === "people" && (
      <>
        <circle cx="9" cy="10" r="3.6" />
        <circle cx="16" cy="10.5" r="3" />
        <path d="M3.6 20c.5-3.4 2.8-5.6 5.9-5.6 2.4 0 4.3 1.3 5.3 3.4" />
        <path d="M13.8 20c.4-2.7 1.9-4.5 3.9-4.9" />
      </>
    )
  }
  {
    name === "spark" && (
      <path
        d="M12 3l1.8 6.2L20 11l-6.2 1.8L12 19l-1.8-6.2L4 11l6.2-1.8z"
        fill="currentColor"
        stroke="none"
      />
    )
  }
  {
    name === "book" && (
      <>
        <path d="M4 6c2.2-1.1 5-1.1 8 0v13c-3-1.1-5.8-1.1-8 0z" />
        <path d="M20 6c-2.2-1.1-5-1.1-8 0v13c3-1.1 5.8-1.1 8 0z" />
      </>
    )
  }
  {
    name === "chat" && (
      <path d="M4.5 5.5h15a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H10l-4.5 4v-4H4.5a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1z" />
    )
  }
  {
    name === "flask" && (
      <>
        <path d="M10 3.5h4" />
        <path d="M11 3.5v6.2l-5.4 9.3a1.2 1.2 0 0 0 1 1.8h10.8a1.2 1.2 0 0 0 1-1.8L13 9.7V3.5" />
        <line x1="8.3" y1="14" x2="15.7" y2="14" />
      </>
    )
  }
  {
    name === "clipboard" && (
      <>
        <rect x="5" y="4.5" width="14" height="16.5" rx="1.6" />
        <rect x="9" y="2.5" width="6" height="3" rx="1" />
        <line x1="8" y1="11" x2="16" y2="11" />
        <line x1="8" y1="15" x2="16" y2="15" />
      </>
    )
  }
  {
    name === "crack" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M9 3.5 13 10 9 13 15 20.5" stroke-width="1.4" />
      </>
    )
  }
  {
    name === "speaker" && (
      <>
        <circle cx="12" cy="8.2" r="3.6" fill="currentColor" stroke="none" />
        <path
          d="M4.8 20.5c0-4.2 3.2-7.4 7.2-7.4s7.2 3.2 7.2 7.4"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }
</svg>
