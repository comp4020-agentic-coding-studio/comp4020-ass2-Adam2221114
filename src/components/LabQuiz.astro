---
export interface QuizQuestion {
  question: string;
  options: string[];
  correct: number;
}

export interface Props {
  quiz: QuizQuestion[];
}

const { quiz } = Astro.props;
---

<div class="lab-quiz">
  {
    quiz.map((item, qIndex) => (
      <fieldset class="quiz-question" data-correct={item.correct}>
        <legend>{item.question}</legend>
        <div class="quiz-options" role="radiogroup">
          {item.options.map((option, oIndex) => (
            <button type="button" class="quiz-option" data-index={oIndex}>
              {option}
            </button>
          ))}
        </div>
        <p class="quiz-feedback" role="status" id={`quiz-feedback-${qIndex}`} />
      </fieldset>
    ))
  }
</div>

<script>
  for (const fieldset of document.querySelectorAll<HTMLFieldSetElement>(".quiz-question")) {
    const correct = Number(fieldset.dataset.correct);
    const feedback = fieldset.querySelector<HTMLParagraphElement>(".quiz-feedback");
    const options = fieldset.querySelectorAll<HTMLButtonElement>(".quiz-option");

    for (const option of options) {
      option.addEventListener("click", () => {
        if (fieldset.dataset.answered) return;
        fieldset.dataset.answered = "true";

        const chosen = Number(option.dataset.index);
        for (const other of options) {
          other.disabled = true;
          if (Number(other.dataset.index) === correct) other.classList.add("is-correct");
        }
        if (chosen !== correct) option.classList.add("is-wrong");

        if (feedback) {
          feedback.textContent = chosen === correct ? "Correct." : "Not quite — the right answer is highlighted.";
          feedback.classList.add(chosen === correct ? "is-correct" : "is-wrong");
        }
      });
    }
  }
</script>

<style>
  .lab-quiz {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .quiz-question {
    padding: 1rem 1.2rem;
    border: 1px solid var(--at-border);
    border-radius: 0.5rem;
    background: var(--at-bg-alt);
  }

  .quiz-question legend {
    padding: 0 0 0.7rem;
    font-weight: 700;
  }

  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .quiz-option {
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--at-border);
    border-radius: 0.4rem;
    background: var(--at-bg);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .quiz-option:not(:disabled):hover {
    border-color: var(--at-primary);
  }

  .quiz-option:disabled {
    cursor: default;
  }

  /* Once answered, every option is disabled — .is-correct/.is-wrong style
     the two that matter and the rest just stay plainly greyed out. */
  .quiz-option.is-correct {
    border-color: var(--at-secondary);
    background: color-mix(in srgb, var(--at-secondary) 16%, var(--at-bg));
    font-weight: 700;
  }

  .quiz-option.is-wrong {
    border-color: var(--at-primary);
    text-decoration: line-through;
  }

  .quiz-feedback {
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    min-height: 1.2em;
  }

  .quiz-feedback.is-correct {
    color: var(--at-secondary);
  }

  .quiz-feedback.is-wrong {
    color: var(--at-primary);
  }
</style>
