---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";
import { groupByMovement } from "../lib/movements";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const groups = groupByMovement(visible);
---

{
  groups.map(({ movement, items }) => (
    <section class="movement-group">
      <h2 class="movement-heading">
        <span class="movement-tag">Movement {movement.letter}</span>
        {movement.title}
      </h2>
      <CardGrid columns={2}>
        {items.map((lecture) => (
          <Card headingLevel="h3" title={lecture.data.title} href={`/lectures/${lecture.id}/`}>
            {lecture.data.description && <p>{lecture.data.description}</p>}
            <p>
              <small>
                Week {lecture.data.week} · {formatCourseDate(lecture.data.date)}
              </small>
            </p>
          </Card>
        ))}
      </CardGrid>
    </section>
  ))
}

<style>
  .movement-group {
    margin-block-end: 2.5rem;
  }

  .movement-group:last-child {
    margin-block-end: 0;
  }

  .movement-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.65rem;
    row-gap: 0.15rem;
    margin-block: 0 1rem;
    font-size: 1.15rem;
  }

  .movement-tag {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }
</style>
