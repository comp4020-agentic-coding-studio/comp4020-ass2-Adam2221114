---
import MdxPageLayout from "astro-theme-university/layouts/MdxPageLayout.astro";
import { siteConfig } from "../site-config";

const { frontmatter, ...direct } = Astro.props;
const { title, description } = (frontmatter ?? direct) as {
  title?: string;
  description?: string;
};
---

<MdxPageLayout {...Astro.props} siteConfig={siteConfig} lead={false}>
  <h1>{title}</h1>
  {description && <p class="lead">{description}</p>}
  <slot />
</MdxPageLayout>
