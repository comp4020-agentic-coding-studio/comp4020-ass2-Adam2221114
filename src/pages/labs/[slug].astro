---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const labs = await getPublishedCollection("labs");
  return labs.map((lab) => ({ params: { slug: lab.id }, props: { lab } }));
}

const { lab } = Astro.props;
const { Content } = await render(lab);
const title = `Lab ${lab.data.number}: ${lab.data.title}`;
---

<ContentLayout title={title} description={lab.data.description} {...siteConfig}>
  <p><strong>Weight:</strong> {lab.data.weight}%</p>
  <Content />
  <RelatedContent entry={lab} collections={graphCollections} />
</ContentLayout>
