---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const people = await getPublishedCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);

// Map the role enum (convenor|tutor|guest|other) to display labels rather than
// rendering the raw lowercase value.
const roleLabels: Record<string, string> = {
  convenor: "Convenor",
  tutor: "Tutor",
  guest: "Guest lecturer",
  other: "",
};
const roleLabel = person.data.role ? roleLabels[person.data.role] : undefined;
// Astro's generated type does not retain the image/alt refinement relationship,
// so narrow the alt at the rendering boundary as well.
const rawPhotoAlt = (person.data as { photoAlt?: unknown }).photoAlt;
const photoAlt = typeof rawPhotoAlt === "string" ? rawPhotoAlt : "";
// Every page owes a description --- it is what a search result and a shared
// link show underneath the title.
const description = person.data.description;
---

<ContentLayout
  title={person.data.title}
  description={description}
  heroImage={person.data.photo ?? undefined}
  heroImageAlt={photoAlt}
  {...siteConfig}
>
  <dl>
    {roleLabel && (
      <>
        <dt>Role</dt>
        <dd>{roleLabel}</dd>
      </>
    )}
    {person.data.affiliation && (
      <>
        <dt>Affiliation</dt>
        <dd>{person.data.affiliation}</dd>
      </>
    )}
    {person.data.email && (
      <>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${person.data.email}`}>{person.data.email}</a>
        </dd>
      </>
    )}
    {person.data.url && (
      <>
        <dt>Web</dt>
        <dd>
          <a href={person.data.url}>{person.data.url}</a>
        </dd>
      </>
    )}
    <dt>Contact</dt>
    <dd>{person.data.contact}</dd>
  </dl>

  <Content />
</ContentLayout>

<style>
  /* Hero.astro's .at-hero-image is a very wide, short (~5:1) full-bleed crop
     with no object-position, so its default centre crop lands on these tall
     portrait photos' torso and cuts the face out entirely. Scoped to this
     page (via :global(), since Hero's <img> doesn't carry this file's scope
     attribute) rather than overriding the theme class everywhere, since the
     home page and 404 page also render an .at-hero-image but with the
     landscape hero-home illustration, which centres fine as-is. */
  :global(.at-hero-image) {
    object-position: 50% 15%;
  }
</style>
